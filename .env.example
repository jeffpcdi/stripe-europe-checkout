# Variáveis de ambiente — copie para o painel do seu host (Railway, Vercel…).
# NUNCA comite valores reais. Preencha os placeholders somente no gerenciador
# de segredos da plataforma ou em um arquivo .env*.local ignorado pelo Git.

# Obrigatória em produção: connection string pooled do Neon/Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Alias aceito: POSTGRES_URL

# Redis/Upstash (opcional; sem elas o app usa memória local).
UPSTASH_REDIS_REST_URL="https://YOUR-INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"
# Aliases aceitos: KV_REST_API_URL, KV_REST_API_TOKEN

# Webhook universal de conversões (opcional).
CONVERSION_WEBHOOK_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Pipeboard / TikTok Ads. A chave fica exclusivamente no servidor.
PIPEBOARD_API_KEY="pk_YOUR_PIPEBOARD_KEY"
# PIPEBOARD_TIKTOK_MCP_URL="https://tiktok-ads.mcp.pipeboard.co/"

# Domínios Railway (opcional; use apenas uma chave válida).
# RAILWAY_API_TOKEN="YOUR_RAILWAY_TOKEN"
# RAILWAY_PROJECT_ID="YOUR_PROJECT_ID"
# RAILWAY_ENVIRONMENT_ID="YOUR_ENVIRONMENT_ID"
# RAILWAY_SERVICE_ID="YOUR_SERVICE_ID"

# TikTok Marketing API direta (necessária apenas se configurar esse conector).
# TIKTOK_ADS_ACCESS_TOKEN="YOUR_TIKTOK_MARKETING_API_ACCESS_TOKEN"

# Origem HTTPS pública usada por feeds, vídeos e callbacks OAuth.
# PRIMARY_HOST="https://seu-app.up.railway.app"
# OAUTH_PUBLIC_ORIGIN="https://seu-app.up.railway.app"

# Detector de anomalias / copiloto (opcional; sem a chave usa frase determinística).
# ANTHROPIC_API_KEY="sk-ant-YOUR_KEY"
# ADS_ANOMALY_INTERVAL_MS="14400000"

# Google Drive → rascunho TikTok (opcional).
# GOOGLE_DRIVE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
# GOOGLE_DRIVE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Dropbox → rascunho TikTok (opcional).
# DROPBOX_APP_KEY="YOUR_DROPBOX_APP_KEY"
# DROPBOX_APP_SECRET="YOUR_DROPBOX_APP_SECRET"

# Chave estável de 24+ caracteres para cifrar tokens OAuth no Neon.
# INTEGRATION_TOKEN_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
# CLOUD_VIDEO_MAX_MB="500"
# CLOUD_VIDEO_SYNC_MS="120000"

# Relatório diário proativo via WhatsApp Cloud API (opcional).
# O template precisa estar aprovado pela Meta e aceitar seis parâmetros.
# WHATSAPP_ACCESS_TOKEN="YOUR_META_SYSTEM_USER_TOKEN"
# WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
# WHATSAPP_DAILY_TEMPLATE="resumo_diario"
# WHATSAPP_TEMPLATE_LANG="pt_BR"
# WHATSAPP_GRAPH_VERSION="v23.0"

# Porta pública; o host normalmente a injeta.
# PORT="3000"
