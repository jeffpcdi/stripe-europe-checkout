CONVERSION_WEBHOOK_SECRET=
DATABASE_URL=
PIPEBOARD_API_KEY=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=

# Segurança de tráfego/domínios (obrigatórios em produção)
TRAFFIC_CHALLENGE_SECRET=
# Opcional durante rotação: aceite temporariamente tokens assinados pela chave anterior
TRAFFIC_CHALLENGE_SECRET_PREVIOUS=
DOMAIN_PROOF_SECRET=
DOMAIN_PROOF_SECRET_PREVIOUS=
# Host público principal (opcional, ajuda o reconciliador de domínios em modo manual)
PUBLIC_APP_HOST=

# Cloudflare for SaaS — provider de NOVOS domínios personalizados
# Token restrito à zona/conta necessária; nunca use Global API Key.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Target técnico que o cliente aponta no CNAME (ex.: customers.roi-nados.top)
CLOUDFLARE_CNAME_TARGET=
# Host técnico designado como fallback origin na zona (ex.: proxy-fallback.roi-nados.top)
CLOUDFLARE_FALLBACK_ORIGIN=
# Só mude para true DEPOIS de Worker + fallback estarem ativos.
CLOUDFLARE_EDGE_READY=false

# Edge Worker → Railway origin
EDGE_DOMAIN_SECRET=
# Opcional durante rotação sem downtime
EDGE_DOMAIN_SECRET_PREVIOUS=
EDGE_ORIGIN_HOST=

# Domínio principal do SaaS: ele e todos os subdomínios são reservados.
PRIMARY_SAAS_DOMAIN=roi-nados.top
# Limite de produto por conta (não é limite técnico do Railway)
CUSTOM_DOMAIN_LIMIT=5000
