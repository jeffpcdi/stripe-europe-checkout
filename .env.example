# ─────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente — copie para o painel do seu host (Railway, Vercel…)
# NUNCA comite valores reais. Este arquivo só documenta os nomes esperados.
# ─────────────────────────────────────────────────────────────────────────

# OBRIGATÓRIA — sem ela o registro/login falha com "Banco de dados não configurado".
# Connection string do Neon (Postgres). Use a versão "pooled" (host com -pooler).
# Onde pegar: Neon Console → Connection Details → Connection string
#          ou Vercel → Project → Settings → Environment Variables → DATABASE_URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# (opcional) aceito como alias caso seu host use este nome:
# POSTGRES_URL=

# OPCIONAIS — Redis (Upstash). Ativa dedup persistente, presença ao vivo e log CAPI.
# Sem elas o app roda em "modo memória" (funciona, mas zera no restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (aliases também aceitos)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# OPCIONAL — segredo do webhook universal de conversões (/api/conversion?secret=...)
CONVERSION_WEBHOOK_SECRET=

# OPCIONAL — notificações push (Pushcut). Também configurável pela dashboard.
PUSHCUT_WEBHOOK_URL=

# OPCIONAL — porta (o host geralmente injeta automaticamente). Default: 3000
# PORT=3000

# ─────────────────────────────────────────────────────────────────────────
# Rede / domínio
# ─────────────────────────────────────────────────────────────────────────

# OPCIONAL — host público principal (ex.: painel.seudominio.com). Entra na lista
# de hosts confiáveis para CSRF/CORS junto do RAILWAY_PUBLIC_DOMAIN.
# PRIMARY_HOST=

# OPCIONAL — domínio do cookie de sessão para compartilhar login entre
# subdomínios (ex.: .seudominio.com). Em branco = cookie preso ao host atual.
# COOKIE_DOMAIN=

# OPCIONAL — upstream da dashboard Next.js para o proxy interno.
# Default: http://127.0.0.1:3001 (só mude se rodar o Next em outra porta/host).
# DASHBOARD_UPSTREAM_URL=http://127.0.0.1:3001

# ─────────────────────────────────────────────────────────────────────────
# Retenção / legado
# ─────────────────────────────────────────────────────────────────────────

# OPCIONAL — dias de retenção dos eventos de navegação. Default 90, faixa 7–3650.
# EVENT_RETENTION_DAYS=90

# OPCIONAIS (LEGADO) — pixel/token TikTok globais, usados só para migrar uma
# instalação antiga de pixel único para o modelo multi-pixel por conta.
# Instalações novas configuram o pixel pela dashboard e deixam ambos em branco.
# TIKTOK_PIXEL_CODE=
# TIKTOK_ACCESS_TOKEN=

# NOTA: as variáveis RAILWAY_* (PUBLIC_DOMAIN, PROJECT_ID, TOKEN…) são injetadas
# automaticamente pela plataforma Railway — não precisa defini-las manualmente.
